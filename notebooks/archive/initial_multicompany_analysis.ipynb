    "# CHANGED: light Arabic normalisation. Original: whitespace split only.\n",
    "_diacritics = re.compile(r\"[\\u0610-\\u061A\\u064B-\\u065F\\u0670\\u06D6-\\u06ED\\u0640]\")   # tashkeel + tatweel\n",
    "_punct      = re.compile(r\"[^\\w\\s]|_\", flags=re.UNICODE)\n",
    "_digits     = re.compile(r\"[0-9\\u0660-\\u0669]+([.,][0-9\\u0660-\\u0669]+)?\")\n",
    "\n",
    "def normalize_ar(text):\n",
    "    text = _diacritics.sub(\"\", text)\n",
    "    text = (text.replace(\"Ø£\", \"Ø§\").replace(\"Ø¥\", \"Ø§\").replace(\"Ø¢\", \"Ø§\")\n",
    "                .replace(\"Ù‰\", \"ÙŠ\").replace(\"Ø©\", \"Ù‡\"))\n",
    "    text = _digits.sub(\" <NUM> \", text)\n",
    "    text = _punct.sub(\" \", text)\n",
    "    return text\n",
    "\n",
    "def tokenize(text, normalize=NORMALIZE_TEXT):\n",
    "    if normalize:\n",
    "        text = normalize_ar(text)\n",
    "    return [w for w in text.split() if w]\n",
    "\n",
    "def build_daily_documents(news_c):\n",
    "    \"\"\"One document per trading day: all headlines of that day joined (as in the original mergeNews).\"\"\"\n",
    "    docs = (news_c.groupby(\"Date\")[\"News\"].apply(\" \".join).reset_index()\n",
    "                  .sort_values(\"Date\").reset_index(drop=True))\n",
    "    docs[\"Tokens\"] = docs[\"News\"].apply(tokenize)\n",
    "    docs[\"NumHeadlines\"] = news_c.groupby(\"Date\").size().reindex(docs[\"Date\"]).values\n",
    "    return docs"
   ]
  },
