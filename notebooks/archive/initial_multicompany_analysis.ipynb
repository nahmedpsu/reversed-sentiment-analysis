    "## 1. Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "a7a1524e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CHANGED: all paths and parameters in one place\n",
    "DATA_DIR = \".\"                  # files sit next to the notebook; use \"/kaggle/input/reversedsentimentdata\" on Kaggle\n",
    "\n",
    "FILES = {\n",
    "    \"companies\": f\"{DATA_DIR}/Companies.csv\",\n",
    "    \"news\":      f\"{DATA_DIR}/AllNews.csv\",            # full file (AllNews_example.csv has the same schema)\n",
    "    \"prices\":    f\"{DATA_DIR}/StockPrices.csv\",\n",
    "}\n",
    "\n",
    "# ---- experiment parameters ----\n",
    "TRAIN_END   = \"2021-12-31\"      # last day of the training window (inclusive); everything after is test\n",
    "TEST_START  = None              # None -> the day after TRAIN_END\n",
    "TEST_END    = None              # None -> last available date\n",
    "\n",
    "ALIGNMENT   = \"next_session\"    # \"next_session\": headline -> first session that opens after publication\n",
    "                                # \"same_day\":     original behaviour (headline date -> same trading day)\n",
    "SESSION_OPEN = \"10:00\"          # Tadawul session open used by the alignment rule (11:00 before Oct-2016 â€” not relevant for 2018+)\n",
    "\n",
    "TARGET      = \"oc_log\"          # \"oc_log\": ln(Close/Open)   \"cc_log\": ln(Close/PrevClose)   \"diff\": Close-Open (original)\n",
    "\n",
    "NORMALIZE_TEXT = True           # strip punctuation/quotes/diacritics, unify alef/ya/ta-marbuta\n",
    "MIN_WORD_FREQ  = 3              # a word must appear in >= this many training documents to enter the lexicon\n",
    "SHRINK_KAPPA   = 0.0            # 0 = plain mean (original); >0 shrinks rare-word scores toward 0: n/(n+kappa)*mean\n",
    "NEUTRAL_EPS    = 0.0            # |score| <= eps counts as \"no call\" in directional accuracy (0 = force a call)\n",
    "\n",
    "SCORE_SCALE = 10000             # cosmetic scale for the daily score (original used *10000)\n",
    "PLOT = True"
   ]
  },
