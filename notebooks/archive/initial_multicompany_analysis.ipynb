    "## 5. Lexicon construction (the *reversed* step)\n",
    "\n",
    "Same rule as the paper: every word of day *t* receives `Change_t / M_t`, where `M_t` is the number of tokens in the\n",
    "day's document; a word's lexicon score is the mean of its contributions over the training days.\n",
    "Additions: minimum document frequency and optional shrinkage toward zero for rare words."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "056072b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_lexicon(train_docs, min_freq=MIN_WORD_FREQ, kappa=SHRINK_KAPPA):\n",
    "    rows = []\n",
    "    for _, r in train_docs.iterrows():\n",
    "        toks = r[\"Tokens\"]\n",
    "        if not toks:\n",
    "            continue\n",
    "        share = r[\"Change\"] / len(toks)                       # equal split of the day's change (original rule)\n",
    "        rows.append(pd.DataFrame({\"Word\": toks, \"Score\": share, \"Date\": r[\"Date\"]}))\n",
    "    if not rows:\n",
    "        return pd.DataFrame(columns=[\"Word\", \"Score\", \"Positive\", \"Negative\", \"Freq\", \"DayFreq\"])\n",
    "    ws = pd.concat(rows, ignore_index=True)\n",
    "    lex = (ws.groupby(\"Word\")\n",
    "             .agg(Score=(\"Score\", \"mean\"), Freq=(\"Score\", \"size\"), DayFreq=(\"Date\", \"nunique\"))\n",
    "             .reset_index())\n",
    "    lex = lex[lex[\"DayFreq\"] >= min_freq].copy()\n",
    "    if kappa > 0:                                             # CHANGED: optional shrinkage for rare words\n",
    "        lex[\"Score\"] = lex[\"Score\"] * lex[\"DayFreq\"] / (lex[\"DayFreq\"] + kappa)\n",
    "    lex[\"Positive\"] = lex[\"Score\"].clip(lower=0)              # S+(w) = max(S,0), S-(w) = min(S,0) as in the paper\n",
    "    lex[\"Negative\"] = lex[\"Score\"].clip(upper=0)\n",
    "    return lex.sort_values(\"Score\", ascending=False).reset_index(drop=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f59de182",
