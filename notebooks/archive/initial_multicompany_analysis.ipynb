   "source": [
    "## 6. Daily sentiment scoring (testing phase)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "9703d91d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CHANGED: score = sum of S+ and S- over the document's tokens (as written in the paper);\n",
    "# unmatched words contribute 0 explicitly. The original get_mean_scores() used a mean and dropped NaNs.\n",
    "def score_document(tokens, lex_index, scale=SCORE_SCALE):\n",
    "    pos = neg = 0.0\n",
    "    matched = 0\n",
    "    for w in tokens:\n",
    "        s = lex_index.get(w)\n",
    "        if s is not None:\n",
    "            matched += 1\n",
    "            if s > 0: pos += s\n",
    "            else:     neg += s\n",
    "    n = max(len(tokens), 1)\n",
    "    return pd.Series({\"Positive\": pos, \"Negative\": neg,\n",
    "                      \"Score\": (pos + neg) * scale,           # sum (paper definition)\n",
    "                      \"ScoreMean\": (pos + neg) / n * scale,   # per-token version (original code behaviour)\n",
    "                      \"Coverage\": matched / n})\n",
    "\n",
    "def score_documents(docs, lex):\n",
    "    lex_index = dict(zip(lex[\"Word\"], lex[\"Score\"]))\n",
    "    scored = docs[\"Tokens\"].apply(lambda t: score_document(t, lex_index))\n",
    "    return pd.concat([docs.drop(columns=[\"Tokens\"]), scored], axis=1)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b3e11599",
   "metadata": {},
   "source": [
    "## 7. Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "3709d795",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _corr(a, b):\n",
    "    a, b = np.asarray(a, float), np.asarray(b, float)\n",
    "    if len(a) < 3 or np.std(a) == 0 or np.std(b) == 0:\n",
    "        return np.nan, np.nan\n",
    "    return stats.pearsonr(a, b)\n",
    "\n",
    "def evaluate(test_scored, score_col=\"Score\", eps=NEUTRAL_EPS):\n",
    "    \"\"\"Same-day association, next-day prediction, directional accuracy and baselines.\"\"\"\n",
    "    df = test_scored.sort_values(\"Date\").reset_index(drop=True)\n",
    "    out = {\"n_test_days\": len(df)}\n",
    "    if len(df) < 3:\n",
    "        return out\n",
    "    s, y = df[score_col], df[\"Change\"]\n",
    "    r, p = _corr(s, y);                     out[\"same_day_r\"], out[\"same_day_p\"] = r, p\n",
    "    r, p = _corr(s[:-1], y[1:]);            out[\"next_day_r\"], out[\"next_day_p\"] = r, p\n",
    "    rho, _ = stats.spearmanr(s, y);         out[\"same_day_spearman\"] = rho\n",
    "\n",
    "    def dir_acc(pred, actual):\n",
    "        call = np.abs(pred) > eps\n",
    "        pred_sign, act_sign = np.sign(pred[call]), np.sign(actual[call])\n",
    "        act_sign = np.where(act_sign == 0, 1, act_sign)\n",
    "        if call.sum() == 0:\n",
    "            return np.nan, np.nan, 0\n",
    "        acc = (pred_sign == act_sign).mean()\n",
    "        up, dn = act_sign == 1, act_sign == -1\n",
    "        bal = np.nanmean([(pred_sign[up] == 1).mean() if up.any() else np.nan,\n",
    "                          (pred_sign[dn] == -1).mean() if dn.any() else np.nan])\n",
    "        return acc, bal, int(call.sum())\n",
    "\n",
    "    out[\"same_day_acc\"], out[\"same_day_bal_acc\"], _ = dir_acc(s.values, y.values)\n",
    "    out[\"next_day_acc\"], out[\"next_day_bal_acc\"], out[\"n_calls\"] = dir_acc(s.values[:-1], y.values[1:])\n",
    "    out[\"majority_baseline\"] = max((y > 0).mean(), (y <= 0).mean())\n",
    "    out[\"mean_coverage\"] = df[\"Coverage\"].mean()\n",
    "    return out"
   ]
  },
