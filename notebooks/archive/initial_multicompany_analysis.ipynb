   "source": [
    "## 8. Run the pipeline for one company"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "859d4db5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_company(cid, news=news, prices=prices, lexicon=None, verbose=True):\n",
    "    \"\"\"Full pipeline for one CompanyID. If `lexicon` is given (e.g. a pooled lexicon) it is used instead of\n",
    "    training a company-specific one.\"\"\"\n",
    "    name = companies.set_index(\"CompanyID\").loc[cid, \"NameEn\"]\n",
    "    p_c = prices[prices.CompanyID == cid].sort_values(\"Date\")\n",
    "    n_c = news[news.CompanyID == cid]\n",
    "    if p_c.empty or n_c.empty:\n",
    "        if verbose: print(f\"[{cid}] {name}: no prices or no news â€” skipped\")\n",
    "        return None\n",
    "\n",
    "    trading_days = pd.DatetimeIndex(p_c[\"Date\"])\n",
    "    n_c = align_news_to_trading_days(n_c, trading_days)\n",
    "    docs = build_daily_documents(n_c).merge(p_c[[\"Date\", \"OpenPrice\", \"ClosePrice\", \"Volume\", \"Change\"]], on=\"Date\")\n",
    "\n",
    "    train_end = pd.Timestamp(TRAIN_END)\n",
    "    test_start = pd.Timestamp(TEST_START) if TEST_START else train_end + pd.Timedelta(days=1)\n",
    "    test_end = pd.Timestamp(TEST_END) if TEST_END else docs[\"Date\"].max()\n",
    "    train = docs[docs.Date <= train_end]\n",
    "    test = docs[(docs.Date >= test_start) & (docs.Date <= test_end)]\n",
    "\n",
    "    lex = lexicon if lexicon is not None else build_lexicon(train)\n",
    "    test_scored = score_documents(test, lex) if len(test) else test.drop(columns=[\"Tokens\"])\n",
    "    train_scored = score_documents(train, lex) if len(train) else train.drop(columns=[\"Tokens\"])\n",
    "\n",
    "    metrics = {\"CompanyID\": cid, \"Company\": name,\n",
    "               \"n_train_days\": len(train), \"n_train_headlines\": int(train[\"NumHeadlines\"].sum()) if len(train) else 0,\n",
    "               \"lexicon_size\": len(lex), \"n_test_headlines\": int(test[\"NumHeadlines\"].sum()) if len(test) else 0}\n",
    "    metrics.update(evaluate(test_scored) if len(test) else {\"n_test_days\": 0})\n",
    "    in_sample = evaluate(train_scored) if len(train) >= 3 else {}\n",
    "    metrics[\"train_same_day_r\"] = in_sample.get(\"same_day_r\", np.nan)   # in-sample (mechanically inflated) for reference\n",
    "\n",
    "    if verbose:\n",
    "        print(f\"[{cid}] {name}: train {metrics['n_train_days']} days / {metrics['n_train_headlines']} headlines, \"\n",
    "              f\"lexicon {metrics['lexicon_size']} words, test {metrics.get('n_test_days', 0)} days\")\n",
    "    return {\"metrics\": metrics, \"lexicon\": lex, \"train\": train_scored, \"test\": test_scored}"
   ]
  },
