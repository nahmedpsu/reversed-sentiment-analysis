    "## 3. Align each headline to a trading day\n",
    "\n",
    "Original notebook: `Date` of the headline = trading day, even if the headline was published after the close.\n",
    "`next_session` rule: a headline published at time Ï„ is assigned to the first trading session of that company\n",
    "that **opens after Ï„**. Pre-open headlines keep the same day; intraday and post-close headlines move to the next\n",
    "trading day; weekend/holiday headlines move to the next trading day."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "2894e17b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CHANGED: timestamp-aware alignment\n",
    "_open_h, _open_m = map(int, SESSION_OPEN.split(\":\"))\n",
    "\n",
    "def align_news_to_trading_days(news_c, trading_days, alignment=ALIGNMENT):\n",
    "    \"\"\"news_c: news rows of one company; trading_days: sorted DatetimeIndex of that company's trading dates.\"\"\"\n",
    "    ts = news_c[\"PublishedOn\"]\n",
    "    if alignment == \"same_day\":\n",
    "        target_day = ts.dt.normalize()\n",
    "    else:\n",
    "        session_open = ts.dt.normalize() + pd.Timedelta(hours=_open_h, minutes=_open_m)\n",
    "        # if published at/after the open -> candidate day is tomorrow, else today\n",
    "        target_day = np.where(ts >= session_open, ts.dt.normalize() + pd.Timedelta(days=1), ts.dt.normalize())\n",
    "        target_day = pd.Series(pd.to_datetime(target_day), index=news_c.index)\n",
    "    # snap the candidate day forward to the next available trading day\n",
    "    td = np.asarray(trading_days.values, dtype=\"datetime64[ns]\")\n",
    "    pos = np.searchsorted(td, target_day.values.astype(\"datetime64[ns]\"), side=\"left\")\n",
    "    valid = pos < len(td)\n",
    "    out = news_c.copy()\n",
    "    out[\"Date\"] = pd.NaT\n",
    "    out.loc[valid, \"Date\"] = pd.to_datetime(td[pos[valid]])\n",
    "    return out.dropna(subset=[\"Date\"])"
   ]
  },
