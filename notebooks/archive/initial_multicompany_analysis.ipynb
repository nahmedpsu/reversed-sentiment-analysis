    "# CHANGED: price-change target is configurable; original was Close - Open\n",
    "def add_target(df, target=TARGET):\n",
    "    df = df.sort_values([\"CompanyID\", \"Date\"]).copy()\n",
    "    prev_close = df.groupby(\"CompanyID\")[\"ClosePrice\"].shift(1)      # per-company lag (pandas>=3 safe: no groupby.apply)\n",
    "    if target == \"diff\":\n",
    "        df[\"Change\"] = df[\"ClosePrice\"] - df[\"OpenPrice\"]\n",
    "    elif target == \"oc_log\":\n",
    "        df[\"Change\"] = np.log(df[\"ClosePrice\"] / df[\"OpenPrice\"])\n",
    "    elif target == \"cc_log\":\n",
    "        df[\"Change\"] = np.log(df[\"ClosePrice\"] / prev_close)\n",
    "    else:\n",
    "        raise ValueError(target)\n",
    "    return df\n",
    "\n",
    "prices = add_target(prices)\n",
    "prices = prices.dropna(subset=[\"Change\"]).reset_index(drop=True)\n",
    "prices.groupby(\"CompanyID\")[\"Change\"].describe().round(4)"
   ]
  },
