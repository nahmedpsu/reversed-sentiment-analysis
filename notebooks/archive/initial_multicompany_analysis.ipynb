    "# CHANGED: pooled lexicon = lexicon built from the training documents of all companies\n",
    "pooled_train = pd.concat([r[\"train\"].assign(CompanyID=cid) for cid, r in results.items()], ignore_index=True)\n",
    "pooled_docs = pooled_train[[\"Date\", \"News\", \"Change\"]].copy()\n",
    "pooled_docs[\"Tokens\"] = pooled_docs[\"News\"].apply(tokenize)\n",
    "pooled_lex = build_lexicon(pooled_docs)\n",
    "print(f\"pooled lexicon: {len(pooled_lex):,} words from {len(pooled_docs):,} firm-days\")\n",
    "\n",
    "pooled_results = {cid: run_company(cid, lexicon=pooled_lex, verbose=False) for cid in results}\n",
    "pooled_summary = (pd.DataFrame([r[\"metrics\"] for r in pooled_results.values() if r])\n",
    "                    .set_index(\"CompanyID\")[[\"Company\", \"n_test_days\", \"same_day_r\", \"next_day_r\",\n",
    "                                             \"next_day_acc\", \"next_day_bal_acc\", \"majority_baseline\"]])\n",
    "\n",
    "comparison = summary[[\"Company\", \"next_day_acc\", \"next_day_bal_acc\", \"majority_baseline\"]].join(\n",
    "    pooled_summary[[\"next_day_acc\", \"next_day_bal_acc\"]], rsuffix=\"_pooled\")\n",
    "comparison.round(3)"
   ]
