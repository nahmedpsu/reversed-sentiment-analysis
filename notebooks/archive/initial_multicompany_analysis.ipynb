   "source": [
    "# CHANGED: StockPrices.csv has no header. Column order inferred from the data:\n",
    "#   0 RowID | 1 Date | 2 MarketCode | 3 CompanyID | 4 (unknown) | 5 Volume | 6 Amount\n",
    "#   7 OpenPrice | 8 ClosePrice | 9 MinPrice | 10 MaxPrice | 11 Trades | 12 flag | 13 flag\n",
    "PRICE_COLS = [\"RowID\", \"Date\", \"MarketCode\", \"CompanyID\", \"Col4\", \"Volume\", \"Amount\",\n",
    "              \"OpenPrice\", \"ClosePrice\", \"MinPrice\", \"MaxPrice\", \"Trades\", \"Flag12\", \"Flag13\"]\n",
    "\n",
    "prices = pd.read_csv(FILES[\"prices\"], header=None, names=PRICE_COLS, encoding=\"utf-8-sig\")\n",
    "prices[\"Date\"] = pd.to_datetime(prices[\"Date\"]).dt.normalize()\n",
    "prices[\"CompanyID\"] = prices[\"CompanyID\"].astype(int)\n",
    "prices = (prices.sort_values([\"CompanyID\", \"Date\"])\n",
    "                .drop_duplicates([\"CompanyID\", \"Date\"])\n",
    "                .reset_index(drop=True))\n",
    "\n",
    "# sanity check on the inferred column mapping: Open and Close must lie inside [Min, Max]\n",
    "ok = ((prices.OpenPrice >= prices.MinPrice) & (prices.OpenPrice <= prices.MaxPrice) &\n",
    "      (prices.ClosePrice >= prices.MinPrice) & (prices.ClosePrice <= prices.MaxPrice)).mean()\n",
    "print(f\"rows: {len(prices):,}  companies: {prices.CompanyID.nunique()}  \"\n",
    "      f\"dates: {prices.Date.min().date()} â†’ {prices.Date.max().date()}  OHLC-consistent: {ok:.3f}\")\n",
    "prices.head()"
   ]
  },
